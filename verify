<!DOCTYPE html>
<html>
<head>
  <title>WGFSDD INSANE ANIMATION</title>
  <style>
    @media (prefers-color-scheme: dark) {
      body {
        background-color: #111;
        background-image: radial-gradient(#333, #000);
      }
    }
    @media (prefers-color-scheme: light) {
      body {
        background-color: #fff;
      }
    }
    .new-animation {
      position: relative;
      top: 20%;
      left: 40%;
      font-size: 48px;
      animation: pulse 1s ease-in-out infinite;
      text-shadow: 1px 1px 2px #000;
    }
    @media (prefers-color-scheme: dark) {
      .new-animation {
        color: #ccc;
      }
    }
    @media (prefers-color-scheme: light) {
      .new-animation {
        color: #000;
      }
    }
    @keyframes pulse {
      0% {
        transform: scale(1);
      }
      50% {
        transform: scale(1.2);
      }
      100% {
        transform: scale(1);
      }
    }
  </style>
</head>
<body>
  <div class="new-animation">WGFSDD NEW ANIMATION</div>
  <script>
    for (let i = 0; i < 100; i++) {
      const div = document.createElement('div');
      div.textContent = 'WGFSDD NEW ANIMATION';
      div.style.position = 'absolute';
      div.style.top = `${Math.random() * 50}%`;
      div.style.left = `${Math.random() * 50}%`;
      div.style.fontSize = `${Math.random() * 24}px`;
      div.style.color = `#${Math.floor(Math.random() * 16777215).toString(16)}`;
      div.style.textShadow = `1px 1px 2px #000`;
      document.body.appendChild(div);
    }
  </script>
</body>
</html>
