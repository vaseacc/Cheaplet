{
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/search", "destination": "/search.html" },
    { "source": "/messages", "destination": "/messages.html" },
    { "source": "/my-listings", "destination": "/my-listings.html" },
    { "source": "/social", "destination": "/social.html" },
    { "source": "/listanitem", "destination": "/listanitem.html" },
    { "source": "/listing", "destination": "/listing.html" },
    { "source": "/profile", "destination": "/profile.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/activity", "destination": "/activity.html" },
    { "source": "/chat", "destination": "/chat.html" },
    { "source": "/user", "destination": "/user.html" },
    { "source": "/tag", "destination": "/tag.html" },
    { "source": "/topic", "destination": "/topic.html" },
    { "source": "/createtopic", "destination": "/createtopic.html" },
    { "source": "/edittopic", "destination": "/edittopic.html" },
    { "source": "/edit-listing", "destination": "/edit-listing.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/safety", "destination": "/safety.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/finish-signup", "destination": "/finish-signup.html" },
    { "source": "/searchsocial", "destination": "/searchsocial.html" },
    { "source": "/admincenter", "destination": "/admincenter.html" },
    { "source": "/__/auth/(.*)", "destination": "/api/__/auth/catch-all" }
  ],
  "redirects": [
    { "source": "/search.html", "destination": "/search", "permanent": true },
    { "source": "/messages.html", "destination": "/messages", "permanent": true },
    { "source": "/my-listings.html", "destination": "/my-listings", "permanent": true },
    { "source": "/social.html", "destination": "/social", "permanent": true },
    { "source": "/listanitem.html", "destination": "/listanitem", "permanent": true },
    { "source": "/listing.html", "destination": "/listing", "permanent": true },
    { "source": "/profile.html", "destination": "/profile", "permanent": true },
    { "source": "/login.html", "destination": "/login", "permanent": true },
    { "source": "/activity.html", "destination": "/activity", "permanent": true },
    { "source": "/chat.html", "destination": "/chat", "permanent": true },
    { "source": "/user.html", "destination": "/user", "permanent": true },
    { "source": "/tag.html", "destination": "/tag", "permanent": true },
    { "source": "/topic.html", "destination": "/topic", "permanent": true },
    { "source": "/createtopic.html", "destination": "/createtopic", "permanent": true },
    { "source": "/edittopic.html", "destination": "/edittopic", "permanent": true },
    { "source": "/edit-listing.html", "destination": "/edit-listing", "permanent": true },
    { "source": "/terms.html", "destination": "/terms", "permanent": true },
    { "source": "/privacy.html", "destination": "/privacy", "permanent": true },
    { "source": "/safety.html", "destination": "/safety", "permanent": true },
    { "source": "/contact.html", "destination": "/contact", "permanent": true },
    { "source": "/finish-signup.html", "destination": "/finish-signup", "permanent": true },
    { "source": "/searchsocial.html", "destination": "/searchsocial", "permanent": true },
    { "source": "/admincenter.html", "destination": "/admincenter", "permanent": true }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=(self)" },
        { "key": "Content-Security-Policy", "value": "default-src 'self' https: data: blob: 'unsafe-inline' 'unsafe-eval'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'" }
      ]
    }
  ]
}
